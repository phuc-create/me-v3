# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
# Create a Vercel access token scoped to the account/team owning the project:
# https://vercel.com/account/tokens
VERCEL_ANALYTICS_TOKEN=

# Vercel project Settings > General > Project ID
VERCEL_ANALYTICS_PROJECT_ID=

# Required for team-owned projects; leave empty for personal-account projects.
# Vercel team Settings > General > Team ID
VERCEL_ANALYTICS_TEAM_ID=
